#!/usr/bin/env bash
#
# agents - task & knowledge helper for the OpenCode agent workflow.
#
# One flat home for every task; gitignored symlinks mark what is in progress:
#
#   knowledge/tasks/<id>.md            every task, committed, whatever its status
#   knowledge/tasks/.active/<id>.md    gitignored symlink -> ../<id>.md (in progress)
#   knowledge/tasks/.active/.current   gitignored symlink -> ../<id>.md (the focus)
#   knowledge/tasks/.gitignore         ignores .active/
#
# The committed file is the single source of truth; a symlink is a pointer, never a
# copy. Nothing under .active/ is committed, so no in-progress task reaches upstream.
#
# Task IDs are immutable: YYYYMMDD-<slug>-<suffix> (no prefix).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_DIR="$(cd "$SCRIPT_DIR/../references" && pwd)"
SELF="$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")"

# date(8) + 2..4 slug words + suffix
ID_RE='^[0-9]{8}(-[a-z0-9]+){3,5}$'
STATUSES='active blocked paused in-review completed'
REQUIRED_KEYS='task title created updated status'
REQUIRED_SECTIONS='## Objective
## Remaining tasks
## Next action'

die() {
    printf 'agents: %s\n' "$*" >&2
    exit 1
}

info() { printf '%s\n' "$*"; }

repo_root() {
    if [ -n "${AGENTS_ROOT:-}" ]; then
        printf '%s\n' "$AGENTS_ROOT"
        return 0
    fi
    git rev-parse --show-toplevel 2>/dev/null ||
        die "not inside a git repository (set AGENTS_ROOT to the checkout root)"
}

knowledge_dir() { printf '%s/knowledge\n' "$(repo_root)"; }
tasks_dir() { printf '%s/tasks\n' "$(knowledge_dir)"; }
active_dir() { printf '%s/.active\n' "$(tasks_dir)"; }
current_link() { printf '%s/.current\n' "$(active_dir)"; }

require_knowledge() {
    [ -d "$(knowledge_dir)" ] ||
        die "knowledge/ not found under $(repo_root); see knowledge/index.md or set AGENTS_ROOT"
}

current_branch() {
    git -C "$(repo_root)" symbolic-ref --short -q HEAD 2>/dev/null | head -n1 || true
}

ref_exists() { git -C "$(repo_root)" rev-parse --verify -q "$1" >/dev/null 2>&1; }
path_in_ref() { git -C "$(repo_root)" cat-file -e "$1:$2" >/dev/null 2>&1; }

# --- frontmatter helpers -----------------------------------------------------

# fm_get <file> <key>: first value of `key:` inside the leading --- block.
fm_get() {
    awk -v k="$2" '
    /^---[[:space:]]*$/ { block++; next }
    block==1 && index($0, k ":")==1 {
      line = $0
      sub("^" k ":[[:space:]]*", "", line)
      gsub(/^["'"'"']|["'"'"']$/, "", line)
      print line
      exit
    }
  ' "$1"
}

# fm_set <file> <key> <value>: replace the value of `key:` inside the block.
fm_set() {
    local file="$1" key="$2" value="$3" tmp
    tmp="$(mktemp)"
    if awk -v k="$key" -v v="$value" '
      /^---[[:space:]]*$/ { block++; print; next }
      {
        if (block==1 && !done && index($0, k ":")==1) { print k ": " v; done=1; next }
        print
      }
      END { exit(done ? 0 : 3) }
    ' "$file" >"$tmp"; then
        mv "$tmp" "$file"
    else
        rm -f "$tmp"
        die "no '$key:' frontmatter field in $file"
    fi
}

validate_id() { printf '%s' "$1" | grep -Eq "$ID_RE"; }

ensure_two_words() {
    local s="$1" n
    n="$(printf '%s' "$s" | tr '-' '\n' | grep -c . || true)"
    if [ "$n" -lt 2 ]; then printf '%s-task\n' "$s"; else printf '%s\n' "$s"; fi
}

make_slug() {
    local text="$1" slug raw
    slug="$(
        printf '%s' "$text" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/ /g' |
            awk '{
        n=0; out=""
        for (i=1; i<=NF && n<4; i++) {
          w=$i
          if (w ~ /^(a|an|the|and|or|of|to|in|on|for|with|into|from|via|using)$/) continue
          if (length(w)<2) continue
          out = (out=="" ? w : out "-" w); n++
        }
        print out
      }'
    )"
    if [ -z "$slug" ]; then
        raw="$(printf '%s' "$text" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/ /g' | awk '{print $1}')"
        slug="${raw:-task}"
    fi
    ensure_two_words "$slug"
}

random_suffix() { (
    set +o pipefail
    LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 4
); }

generate_id() {
    local slug="$1" date suffix id n=0
    date="$(date +%Y%m%d)"
    while :; do
        suffix="$(random_suffix)"
        id="$date-$slug-$suffix"
        if [ ! -e "$(tasks_dir)/$id.md" ]; then
            printf '%s\n' "$id"
            return 0
        fi
        n=$((n + 1))
        [ "$n" -lt 50 ] || die "could not find a unique task id after 50 attempts"
    done
}

sed_esc() { printf '%s' "$1" | tr '\n' ' ' | sed -e 's/[\\&|]/\\&/g'; }

# --- task-set helpers --------------------------------------------------------

# task_files: the flat, committed checkpoints (never anything under .active/).
task_files() {
    [ -d "$(tasks_dir)" ] || return 0
    find "$(tasks_dir)" -maxdepth 1 -type f -name '*.md' | sort
}

task_ids() {
    local f
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        basename "$f" .md
    done < <(task_files)
}

is_active() { [ -L "$(active_dir)/$1.md" ]; }

active_ids() {
    [ -d "$(active_dir)" ] || return 0
    find "$(active_dir)" -maxdepth 1 -type l -name '*.md' -printf '%f\n' 2>/dev/null |
        sed 's/\.md$//' | sort
}

link_task() { mkdir -p "$(active_dir)"; ln -sfn "../$1.md" "$(active_dir)/$1.md"; }
unlink_task() { rm -f "$(active_dir)/$1.md"; }
set_current() { mkdir -p "$(active_dir)"; ln -sfn "../$1.md" "$(current_link)"; }

current_id() {
    local link target
    link="$(current_link)"
    [ -L "$link" ] || return 0
    target="$(readlink "$link")" || return 0
    target="${target##*/}"
    printf '%s\n' "${target%.md}"
}

# Keep the local working state out of git, even on a fresh checkout.
ensure_gitignore() {
    local gi
    gi="$(tasks_dir)/.gitignore"
    if [ -f "$gi" ] && grep -q '^\.active/' "$gi"; then
        return 0
    fi
    printf '# Local, uncommitted working state: symlinks to in-progress tasks.\n.active/\n' >>"$gi"
}

# --- commands ----------------------------------------------------------------

cmd_help() {
    cat <<'USAGE'
agents - task & knowledge helper (all tasks live in knowledge/tasks/)

Usage: agents <command> [arguments]

  new "<objective>" [--slug s] [--issue URL] [--branch b]
                        Create a task, link it active, make it current, print its id
  list [--all] [--status S]
                        List active tasks (--all: every task, any status)
  status                Show the current task and all active tasks
  find [--base REF] [--branch B] [--text Q] [--active]
                        List tasks that belong to this branch: absent from the
                        mainline (origin/main, main) or stamped with this branch
  resume <TASK-ID>      Make an already-active task current
  reopen <TASK-ID>      Continue a completed/closed task (re-link it, make it current)
  touch <TASK-ID>       Refresh the checkpoint's `updated` date
  complete <TASK-ID>    Mark a task completed and unlink it (file stays in place)
  validate              Check ids, frontmatter, sections and local .active/ state
  commits <TASK-ID>     Commits that touch the task's file (task -> commit)
  tasks <REV>           Task ids changed by a commit (commit -> task)
  stale [--days N]      Report active tasks not updated in N days (default 14)
  selftest              Run the end-to-end self-test in a throwaway repo
  help                  Show this help
USAGE
}

cmd_new() {
    local title="" slug="" issue="-" branch="-"
    while [ $# -gt 0 ]; do
        case "$1" in
        --slug)
            slug="${2:?--slug needs a value}"
            shift 2
            ;;
        --issue)
            issue="${2:?--issue needs a value}"
            shift 2
            ;;
        --branch)
            branch="${2:?--branch needs a value}"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown option for new: $1"
            ;;
        *)
            title="${title:+$title }$1"
            shift
            ;;
        esac
    done
    [ -n "$title" ] || die 'usage: agents new "<objective>" [--slug s] [--issue URL] [--branch b]'
    require_knowledge
    mkdir -p "$(tasks_dir)"
    ensure_gitignore

    if [ -n "$slug" ]; then
        slug="$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
    else
        slug="$(make_slug "$title")"
    fi
    slug="$(ensure_two_words "${slug:-task}")"

    local id file today
    id="$(generate_id "$slug")"
    file="$(tasks_dir)/$id.md"
    [ -e "$file" ] && die "refusing to overwrite existing checkpoint: $file"
    today="$(date +%Y-%m-%d)"
    if [ -z "$branch" ] || [ "$branch" = "-" ]; then
        branch="$(current_branch)"
        [ -n "$branch" ] || branch="-"
    fi

    sed \
        -e "s|{{TASK_ID}}|$(sed_esc "$id")|g" \
        -e "s|{{TITLE}}|$(sed_esc "$title")|g" \
        -e "s|{{DATE}}|$(sed_esc "$today")|g" \
        -e "s|{{BRANCH}}|$(sed_esc "$branch")|g" \
        -e "s|{{ISSUE}}|$(sed_esc "$issue")|g" \
        "$TEMPLATE_DIR/task-template.md" >"$file"

    link_task "$id"
    set_current "$id"

    printf '%s\n' "$id"
    info "checkpoint: $file"

    local other ob
    while IFS= read -r other; do
        [ -n "$other" ] || continue
        ob="$(fm_get "$(tasks_dir)/$other.md" branch)"
        if [ "$ob" = "$branch" ]; then
            info "note: branch '$branch' already has active task $other — 'agents resume $other' if it covers this work"
            break
        fi
    done < <(active_ids | grep -vx "$id" || true)
}

cmd_list() {
    local all=0 status_filter=""
    while [ $# -gt 0 ]; do
        case "$1" in
        --all)
            all=1
            shift
            ;;
        --status)
            status_filter="${2:?--status needs a value}"
            shift 2
            ;;
        *) die "unknown option for list: $1" ;;
        esac
    done
    require_knowledge
    local ids id file st up br title mark found=0 rows=""
    if [ "$all" -eq 1 ]; then
        ids="$(task_ids)"
    else
        ids="$(active_ids)"
    fi
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        file="$(tasks_dir)/$id.md"
        [ -f "$file" ] || continue
        st="$(fm_get "$file" status)"
        if [ -n "$status_filter" ] && [ "$st" != "$status_filter" ]; then continue; fi
        up="$(fm_get "$file" updated)"
        br="$(fm_get "$file" branch)"
        title="$(fm_get "$file" title)"
        if is_active "$id"; then mark='*'; else mark='-'; fi
        rows+="$(printf '%-3s %-38s %-10s %-10s %-24s %s\n' "$mark" "$id" "${st:--}" "${up:--}" "${br:--}" "$title")"$'\n'
        found=1
    done <<<"$ids"
    if [ "$found" -eq 1 ]; then
        printf '%-3s %-38s %-10s %-10s %-24s %s\n' A ID STATUS UPDATED BRANCH TITLE
        printf '%s' "$rows"
    else
        info "no matching tasks under $(tasks_dir)"
    fi
}

cmd_status() {
    require_knowledge
    local cur file
    cur="$(current_id)"
    if [ -n "$cur" ] && [ -f "$(tasks_dir)/$cur.md" ]; then
        file="$(tasks_dir)/$cur.md"
        info "current task: $cur"
        info "checkpoint:  $file"
        info "status:      $(fm_get "$file" status)"
    elif [ -n "$cur" ]; then
        info "current pointer '$cur' has no checkpoint (stale .current)"
    else
        info "no active task (knowledge/tasks/.active/.current is unset)"
    fi
    info ""
    info "active tasks:"
    cmd_list
}

cmd_find() {
    local text="" only_active=0 branch="" base=""
    while [ $# -gt 0 ]; do
        case "$1" in
        --text)
            text="${2:?--text needs a value}"
            shift 2
            ;;
        --active)
            only_active=1
            shift
            ;;
        --branch)
            branch="${2:?--branch needs a value}"
            shift 2
            ;;
        --base)
            base="${2:?--base needs a value}"
            shift 2
            ;;
        *) die "unknown option for find: $1" ;;
        esac
    done
    require_knowledge
    [ -n "$branch" ] || branch="$(current_branch)"
    local -a bases=()
    if [ -n "$base" ]; then
        bases=("$base")
    else
        if ref_exists origin/main; then bases+=(origin/main); fi
        if ref_exists main; then bases+=(main); fi
    fi

    local id file br st up title mark rel match islocal ref found=0 rows=""
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        file="$(tasks_dir)/$id.md"
        [ -f "$file" ] || continue
        if [ "$only_active" -eq 1 ] && ! is_active "$id"; then continue; fi
        if [ -n "$text" ] && ! grep -qi -- "$text" "$file"; then continue; fi
        rel="knowledge/tasks/$id.md"
        islocal=1
        for ref in "${bases[@]}"; do
            if path_in_ref "$ref" "$rel"; then islocal=0; fi
        done
        br="$(fm_get "$file" branch)"
        match=0
        if [ -n "$branch" ] && [ "$br" = "$branch" ]; then match=1; fi
        if [ "$islocal" -eq 1 ]; then match=1; fi
        [ "$match" -eq 1 ] || continue
        st="$(fm_get "$file" status)"
        up="$(fm_get "$file" updated)"
        title="$(fm_get "$file" title)"
        if is_active "$id"; then mark='*'; else mark='-'; fi
        rows+="$(printf '%-3s %-38s %-10s %-10s %-24s %s\n' "$mark" "$id" "${st:--}" "${up:--}" "${br:--}" "$title")"$'\n'
        found=1
    done < <(task_ids)

    info "branch: ${branch:--}   base: ${bases[*]:-none}   (* = active)"
    if [ "$found" -eq 1 ]; then
        printf '%-3s %-38s %-10s %-10s %-24s %s\n' A ID STATUS UPDATED BRANCH TITLE
        printf '%s' "$rows"
    else
        info "no matching tasks under $(tasks_dir)"
    fi
}

cmd_resume() {
    [ $# -eq 1 ] || die "usage: agents resume <TASK-ID>"
    local id="$1" file
    validate_id "$id" || die "invalid task id: $id (expected YYYYMMDD-<slug>-<suffix>)"
    require_knowledge
    file="$(tasks_dir)/$id.md"
    [ -f "$file" ] || die "no checkpoint: knowledge/tasks/$id.md"
    if ! is_active "$id"; then
        die "$id is not active; continue it with 'agents reopen $id', or start a new task"
    fi
    set_current "$id"
    info "resumed $id -> $file"
}

cmd_reopen() {
    [ $# -eq 1 ] || die "usage: agents reopen <TASK-ID>"
    local id="$1" file today
    validate_id "$id" || die "invalid task id: $id (expected YYYYMMDD-<slug>-<suffix>)"
    require_knowledge
    file="$(tasks_dir)/$id.md"
    [ -f "$file" ] || die "no checkpoint: knowledge/tasks/$id.md"
    today="$(date +%Y-%m-%d)"
    fm_set "$file" status active
    fm_set "$file" updated "$today"
    fm_set "$file" completed ""
    link_task "$id"
    set_current "$id"
    info "reopened $id -> $file"
}

cmd_touch() {
    [ $# -eq 1 ] || die "usage: agents touch <TASK-ID>"
    local id="$1" file today old
    file="$(tasks_dir)/$id.md"
    [ -f "$file" ] || die "no checkpoint: knowledge/tasks/$id.md"
    today="$(date +%Y-%m-%d)"
    old="$(fm_get "$file" updated)"
    if [ "$old" = "$today" ]; then
        info "$id already updated $today"
        return 0
    fi
    fm_set "$file" updated "$today"
    info "updated $id -> $today"
}

cmd_complete() {
    [ $# -eq 1 ] || die "usage: agents complete <TASK-ID>"
    local id="$1" file today cur next
    file="$(tasks_dir)/$id.md"
    [ -f "$file" ] || die "no checkpoint: knowledge/tasks/$id.md"
    today="$(date +%Y-%m-%d)"
    fm_set "$file" status completed
    fm_set "$file" updated "$today"
    fm_set "$file" completed "$today"
    unlink_task "$id"
    cur="$(current_id)"
    if [ "$cur" = "$id" ]; then
        next="$(active_ids | head -n1 || true)"
        if [ -n "$next" ]; then set_current "$next"; else rm -f "$(current_link)"; fi
    fi
    info "marked $id completed (kept at knowledge/tasks/$id.md)"
}

cmd_validate() {
    require_knowledge
    local root
    root="$(repo_root)"
    local -a errors=()
    local file id key val st head
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        id="$(basename "$file" .md)"
        if ! validate_id "$id"; then
            errors+=("${file#"$root"/}: filename is not YYYYMMDD-<slug>-<suffix>.md")
            continue
        fi
        for key in $REQUIRED_KEYS; do
            val="$(fm_get "$file" "$key")"
            [ -n "$val" ] || errors+=("${file#"$root"/}: missing frontmatter '$key'")
        done
        [ "$(fm_get "$file" task)" = "$id" ] ||
            errors+=("${file#"$root"/}: frontmatter task does not match filename")
        st="$(fm_get "$file" status)"
        case " $STATUSES " in
        *" $st "*) ;;
        *) errors+=("${file#"$root"/}: unknown status '$st'") ;;
        esac
        while IFS= read -r head; do
            [ -n "$head" ] || continue
            grep -qF "$head" "$file" || errors+=("${file#"$root"/}: missing section '$head'")
        done <<<"$REQUIRED_SECTIONS"
        if is_active "$id" && [ "$st" = "completed" ]; then
            errors+=("knowledge/tasks/.active/$id.md: completed task is linked as active")
        fi
    done < <(task_files)

    local ad link cl target cid
    ad="$(active_dir)"
    if [ -d "$ad" ]; then
        while IFS= read -r link; do
            [ -n "$link" ] || continue
            [ -e "$link" ] || errors+=("${link#"$root"/}: dangling symlink")
        done < <(find "$ad" -maxdepth 1 -type l | sort)
        cl="$(current_link)"
        if [ -L "$cl" ]; then
            target="$(readlink "$cl")"
            if [ ! -e "$cl" ]; then
                errors+=("knowledge/tasks/.active/.current is dangling ($target)")
            else
                cid="$(current_id)"
                if [ -n "$cid" ] && [ ! -L "$ad/$cid.md" ]; then
                    errors+=("knowledge/tasks/.active/.current points at $cid, which is not linked as active")
                fi
            fi
        elif [ -e "$cl" ]; then
            errors+=("knowledge/tasks/.active/.current is not a symlink")
        fi
    fi

    local idx ref
    idx="$(knowledge_dir)/index.md"
    if [ -f "$idx" ]; then
        while IFS= read -r ref; do
            [ -n "$ref" ] || continue
            [ -e "$root/$ref" ] || errors+=("knowledge/index.md references missing file: $ref")
        done < <(grep -oE 'knowledge/[A-Za-z0-9._/-]+\.md' "$idx" | sort -u)
    else
        errors+=("missing knowledge/index.md")
    fi

    if [ "${#errors[@]}" -eq 0 ]; then
        info "validate: OK"
        return 0
    fi
    local e
    for e in "${errors[@]}"; do printf 'validate: %s\n' "$e" >&2; done
    info "validate: ${#errors[@]} problem(s) found"
    return 1
}

# Task <-> commit mapping comes from the task file's own history: the commit that
# added or changed knowledge/tasks/<id>.md is the one that concerns that task.

cmd_commits() {
    [ $# -eq 1 ] || die "usage: agents commits <TASK-ID>"
    local id="$1" rel out
    validate_id "$id" || die "invalid task id: $id (expected YYYYMMDD-<slug>-<suffix>)"
    rel="knowledge/tasks/$id.md"
    out="$(git -C "$(repo_root)" log --follow --format='%h %ad %s' --date=short -- "$rel" || true)"
    if [ -n "$out" ]; then
        printf '%s\n' "$out"
    else
        info "no commit touches $rel yet"
    fi
}

cmd_tasks() {
    [ $# -eq 1 ] || die "usage: agents tasks <REV>"
    local rev="$1" line base found=0
    git -C "$(repo_root)" rev-parse --verify -q "$rev" >/dev/null || die "unknown revision: $rev"
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        base="${line#knowledge/tasks/}"
        case "$base" in
        */*) continue ;;
        *.md) ;;
        *) continue ;;
        esac
        printf '%s\n' "${base%.md}"
        found=1
    done < <(git -C "$(repo_root)" show --name-only --format= "$rev" -- knowledge/tasks 2>/dev/null | sort -u || true)
    if [ "$found" -eq 0 ]; then
        info "no task file changed by $rev"
    fi
}

cmd_stale() {
    local days=14
    while [ $# -gt 0 ]; do
        case "$1" in
        --days)
            days="${2:?--days needs a number}"
            shift 2
            ;;
        *) die "usage: agents stale [--days N]" ;;
        esac
    done
    require_knowledge
    local cutoff
    cutoff="$(date -d "-$days days" +%Y-%m-%d 2>/dev/null || date -v-"${days}"d +%Y-%m-%d)"
    local id file up st found=0 total=0 active_count
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        file="$(tasks_dir)/$id.md"
        total=$((total + 1))
        st="$(fm_get "$file" status)"
        [ "$st" = "active" ] || continue
        up="$(fm_get "$file" updated)"
        if [ -n "$up" ] && [ "$up" \< "$cutoff" ]; then
            printf 'stale: %s (updated %s)\n' "$id" "$up"
            found=1
        fi
    done < <(task_ids)
    active_count="$(active_ids | wc -l | tr -d ' ')"
    info "tasks: $total   linked active: $active_count"
    [ "$found" -eq 1 ] || info "no active task older than $days days"
}

# --- self-test ---------------------------------------------------------------

cmd_selftest() {
    local tmp
    tmp="$(mktemp -d)"
    trap 'rm -rf "${tmp:-}"' EXIT

    local pass=0 fail=0
    ok() { pass=$((pass + 1)); }
    bad() {
        fail=$((fail + 1))
        printf 'FAIL: %s\n' "$1" >&2
    }
    eq() { if [ "$1" = "$2" ]; then ok; else bad "$3 (expected '$1', got '$2')"; fi; }
    ne() { if [ "$1" != "$2" ]; then ok; else bad "$3 (both '$1')"; fi; }
    has() {
        case "$1" in
        *"$2"*) ok ;;
        *) bad "$3" ;;
        esac
    }
    lacks() {
        case "$1" in
        *"$2"*) bad "$3" ;;
        *) ok ;;
        esac
    }
    fexists() { if [ -f "$1" ]; then ok; else bad "expected file $1"; fi; }
    fabsent() { if [ -e "$1" ]; then bad "expected no file $1"; else ok; fi; }
    linked() { if [ -L "$1" ]; then ok; else bad "expected symlink $1"; fi; }
    notlinked() { if [ -L "$1" ]; then bad "expected no symlink $1"; else ok; fi; }
    target() { readlink "$1" | sed 's#.*/##; s#\.md$##'; }

    export AGENTS_ROOT="$tmp/repo"
    mkdir -p "$AGENTS_ROOT/knowledge/tasks"
    : >"$AGENTS_ROOT/knowledge/index.md"
    git -C "$AGENTS_ROOT" init -q
    git -C "$AGENTS_ROOT" -c user.email=t@t -c user.name=t commit -q --allow-empty -m init

    local run=("$SELF")
    local tasks="$AGENTS_ROOT/knowledge/tasks"
    local active="$tasks/.active"
    local curlink="$active/.current"
    local out id1 id2 id3

    out="$("${run[@]}" new "parser nesting support" --slug parser-nesting 2>&1)"
    id1="$(printf '%s\n' "$out" | head -n1)"
    printf '%s' "$id1" | grep -Eq "$ID_RE" && ok || bad "new returned an invalid id '$id1'"
    fexists "$tasks/$id1.md"
    linked "$active/$id1.md"
    eq "$id1" "$(target "$curlink")" "new points .current at the task"
    eq "$id1" "$(fm_get "$tasks/$id1.md" task)" "frontmatter task matches filename"
    has "$(fm_get "$tasks/$id1.md" title)" "parser nesting" "frontmatter keeps the title"
    fexists "$tasks/.gitignore"
    has "$(cat "$tasks/.gitignore")" ".active/" "new ensures .active/ is ignored"

    out="$("${run[@]}" new "parser nesting support" --slug parser-nesting 2>&1)"
    id2="$(printf '%s\n' "$out" | head -n1)"
    ne "$id1" "$id2" "ids are unique"

    out="$("${run[@]}" list)"
    has "$out" "$id1" "list shows the first task"
    has "$out" "$id2" "list shows the second task"

    "${run[@]}" resume "$id1" >/dev/null
    eq "$id1" "$(target "$curlink")" "resume repoints .current"

    "${run[@]}" validate >/dev/null && ok || bad "validate passes on a clean tree"

    printf 'not a checkpoint\n' >"$tasks/not-an-id.md"
    out="$("${run[@]}" validate 2>&1 || true)"
    has "$out" "not YYYYMMDD" "validate rejects a bad filename"
    rm -f "$tasks/not-an-id.md"

    "${run[@]}" complete "$id2" >/dev/null
    notlinked "$active/$id2.md"
    fexists "$tasks/$id2.md"
    eq completed "$(fm_get "$tasks/$id2.md" status)" "complete sets status completed"

    ln -s "../$id2.md" "$active/$id2.md"
    out="$("${run[@]}" validate 2>&1 || true)"
    has "$out" "completed task is linked" "validate rejects a linked completed task"
    rm -f "$active/$id2.md"

    "${run[@]}" reopen "$id2" >/dev/null
    linked "$active/$id2.md"
    eq active "$(fm_get "$tasks/$id2.md" status)" "reopen restores active"
    eq "$id2" "$(target "$curlink")" "reopen repoints .current"

    "${run[@]}" complete "$id1" >/dev/null
    out="$("${run[@]}" list)"
    has "$out" "$id2" "default list shows the active task"
    lacks "$out" "$id1" "default list hides the completed one"
    out="$("${run[@]}" list --all)"
    has "$out" "$id1" "--all shows completed tasks"
    "${run[@]}" reopen "$id1" >/dev/null

    rm -f "$curlink"
    ln -s "../nope.md" "$curlink"
    out="$("${run[@]}" validate 2>&1 || true)"
    has "$out" "dangling" "validate rejects a dangling .current"
    rm -f "$curlink"
    "${run[@]}" resume "$id1" >/dev/null

    printf 'KEEP\n' >"$AGENTS_ROOT/knowledge/keepme.md"
    "${run[@]}" new "unrelated follow up" --slug follow-up >/dev/null
    eq "KEEP" "$(cat "$AGENTS_ROOT/knowledge/keepme.md")" "new does not touch unrelated files"

    out="$(AGENTS_ROOT="$tmp/empty" "${run[@]}" list 2>&1 || true)"
    has "$out" "knowledge/" "missing knowledge dir is reported"

    git -C "$AGENTS_ROOT" add -A
    git -C "$AGENTS_ROOT" -c user.email=t@t -c user.name=t commit -q -m "record tasks"
    git -C "$AGENTS_ROOT" branch base
    out="$("${run[@]}" tasks HEAD)"
    has "$out" "$id1" "tasks lists a task changed by the commit"
    has "$out" "$id2" "tasks lists the second task"
    out="$("${run[@]}" commits "$id1")"
    has "$out" "record tasks" "commits finds the commit from the task file history"

    out="$("${run[@]}" new "brand new work" --slug brand-new 2>&1)"
    id3="$(printf '%s\n' "$out" | head -n1)"
    out="$("${run[@]}" find --base base --branch nomatch)"
    has "$out" "$id3" "find lists a task absent from the base"
    lacks "$out" "$id1" "find excludes a task present in the base"
    out="$("${run[@]}" find --base base --branch nomatch --text brand-new)"
    has "$out" "$id3" "find --text filters"
    git -C "$AGENTS_ROOT" add -A
    git -C "$AGENTS_ROOT" -c user.email=t@t -c user.name=t commit -q -m "add brand new"
    out="$("${run[@]}" tasks HEAD)"
    has "$out" "$id3" "tasks lists a task added by a later commit"
    lacks "$out" "$id1" "tasks excludes a task the commit did not touch"
    "${run[@]}" complete "$id3" >/dev/null
    out="$("${run[@]}" find --base base --branch nomatch --active)"
    lacks "$out" "$id3" "find --active hides a completed task"

    local plugin="$SCRIPT_DIR/../../../plugins/task-context.js"
    fexists "$plugin"
    has "$(cat "$plugin")" 'session.hook("compaction"' "plugin steers compaction"
    has "$(cat "$plugin")" "agents find" "plugin points at agents find"
    if command -v node >/dev/null 2>&1; then
        if out="$(node "$SCRIPT_DIR/plugin-test.mjs" 2>&1)"; then
            has "$out" "0 failed" "plugin unit test passes"
        else
            bad "plugin unit test failed:
$out"
        fi
    else
        printf 'note: node not found, skipping the plugin unit test\n'
    fi

    printf '\nselftest: %d passed, %d failed\n' "$pass" "$fail"
    [ "$fail" -eq 0 ]
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
    new) cmd_new "$@" ;;
    list) cmd_list "$@" ;;
    status) cmd_status "$@" ;;
    find) cmd_find "$@" ;;
    resume) cmd_resume "$@" ;;
    reopen) cmd_reopen "$@" ;;
    touch) cmd_touch "$@" ;;
    complete) cmd_complete "$@" ;;
    validate) cmd_validate "$@" ;;
    commits) cmd_commits "$@" ;;
    tasks) cmd_tasks "$@" ;;
    stale) cmd_stale "$@" ;;
    selftest) cmd_selftest "$@" ;;
    help | -h | --help) cmd_help ;;
    *) die "unknown command: $cmd (try 'agents help')" ;;
    esac
}

main "$@"
